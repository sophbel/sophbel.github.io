{
  "name": "belman-lab-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-cms-config.ts && node scripts/vendor-cms.ts && astro dev",
    "build": "node scripts/generate-cms-config.ts && node scripts/vendor-cms.ts && astro build && node scripts/check-base-paths.ts",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:cms": "node scripts/generate-cms-config.ts",
    "sync:orcid": "node scripts/fetch-orcid.ts",
    "vendor:cms": "node scripts/vendor-cms.ts",
    "check:paths": "node scripts/check-base-paths.ts",
    "check:responsive": "node scripts/check-responsive.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/archivo": "5.3.0",
    "astro": "^7.3.2",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@sveltia/cms": "^0.208.2",
    "@types/node": "^24.0.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  }
}
