---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/paths.ts';
import { NAV } from '../lib/nav.ts';
---
<BaseLayout title="Page not found" description="That page does not exist." noindex>
  <h1>That page doesn’t exist</h1>

  <p>
    The address may be mistyped, or the page may have been renamed. Nothing is
    broken — you’re still on the site.
  </p>

  <p>Try one of these instead:</p>

  {/*
    `NAV`, not `COLLECTION_NAV`. The whole list includes the shelved sections,
    which are built no longer, so mapping it offered nine links of which six
    were 404s - on the one page whose job is to get someone unstuck. The two
    names differ by a filter and by nothing at the call site;
    test/shelved.test.ts is what tells them apart now.

    Every entry is a link, so they take the heading colour with a grey
    underline rather than the accent: a list where colour marks everything
    marks nothing. `role="list"` because the class takes the markers off, and
    a <ul> with no list-style is a <ul> Safari stops announcing as a list.
  */}
  <ul class="link-list" role="list">
    <li><a href={url('/')}>Home</a></li>
    <li><a href={url('/research')}>Research</a></li>
    {NAV.map((item) => (
      <li><a href={url(item.href)}>{item.label}</a></li>
    ))}
  </ul>
</BaseLayout>
