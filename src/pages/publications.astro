---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationList from '../components/PublicationList.astro';
import SectionIndex from '../components/SectionIndex.astro';
import { publicationsWithSizes } from '../lib/publication-data.ts';
import { publicationLists } from '../lib/publications.ts';

/*
 * The list is kept by hand, in one file, through the CMS. Two lists come out
 * of it: every entry under "All publications", and the ones marked selected,
 * above it. A selected paper is therefore in both, which is
 * what the second list is for: it is the record, and the first is a view onto
 * it.
 */
const { selected, all } = publicationLists(publicationsWithSizes);

// The index of this page, built from the same conditions that decide whether
// each section is rendered, so it can never point at a heading that is not
// there.
const sections: [string, string][] = [
  ...(selected.length > 0 ? [['selected', 'Selected publications'] as [string, string]] : []),
  ['all', 'All publications'],
];
---
<BaseLayout title="Publications" description="Publications from the Belman Lab.">
  <h1>Publications</h1>
  <SectionIndex sections={sections} />

  {selected.length > 0 && (
    <section id="selected">
      <h2>Selected publications</h2>
      <PublicationList publications={selected} showImages />
    </section>
  )}

  <section id="all">
    <h2>All publications</h2>
    <PublicationList publications={all} />
  </section>
</BaseLayout>
