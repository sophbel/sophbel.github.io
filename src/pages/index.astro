---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
// Commented out with the strip below, because an import nothing uses fails
// `astro check` under the strict config.
// import FunderStrip from '../components/FunderStrip.astro';

const page = await getEntry('pages', 'home');
if (!page) throw new Error('Missing src/content/pages/home.md');
const { Content } = await render(page);
---
<BaseLayout
  title={page.data.title as string}
  description={page.data.description as string | undefined}
  identityIsHeading
>
  <Content />

  {/*
    The home page used to close on who funds the work, and should again once
    the awards are real. `src/data/fixtures/funders.json` still holds three
    stand-ins - "FBN, Funding Body Name" and two more - and with the demo
    notices gone there is nothing on the page left to say so. Replace the
    contents of that file and uncomment this and the import above.

    Commented rather than deleted for the same reason the seven shelved
    sections are only underscore-prefixed: this is waiting on content, not on
    a decision. See `src/lib/nav.ts`.
  */}
  {/* <FunderStrip /> */}
</BaseLayout>
