---
/**
 * The three profile marks, inline.
 *
 * Inline SVG rather than an icon font or three files. A font would be a second
 * typeface on a site whose whole argument is one, and three requests for three
 * marks of a few hundred bytes each costs more than the markup does. Drawn in
 * `currentColor`, so each one is whatever colour its link is and there is no
 * second place to change when that changes.
 *
 * `aria-hidden`, because the link says ORCID, GitHub or Scholar in real text
 * beside it. An icon repeating the word next to it is the word twice.
 *
 * The paths are from Simple Icons (CC0 1.0) - see CREDITS.md. The marks
 * themselves are trademarks of their owners and are used here for what they
 * are for: linking to her record on each service.
 *
 * ORCID publishes brand guidance asking for its iD in ORCID green, #A6CE39.
 * This site has one hue and it means "goes somewhere", so all three are set in
 * it instead; the alternative is a single green mark in an otherwise
 * achromatic palette, which would read as a foreign object rather than as a
 * brand.
 */
export type IconName = 'orcid' | 'github' | 'scholar';

interface Props {
  name: IconName;
}
const { name } = Astro.props;

const PATHS: Record<IconName, string> = {
  orcid:
    'M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 0 1-.947-.947c0-.516.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416zm1.444 1.303v7.444h2.297c2.359 0 3.588-1.444 3.588-3.722 0-2.016-1.05-3.722-3.694-3.722h-2.191z',
  github:
    'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  scholar:
    'M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z',
